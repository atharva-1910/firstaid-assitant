    "dog": {
      "urgency_rules": [
        {
          "if": {
            "flag": "severe_bite"
          },
          "urgency": "emergency"
        },
        {
          "if": {},
          "urgency": "clinic"
        }
      ],
      "steps": [
        {
          "id": "bite_dog_s1",
          "order": 1,
          "text": {
            "en": "Move away from the animal to a safe place.",
            "hi": "जानवर से दूर किसी सुरक्षित जगह पर चले जाएँ।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 323,
            "quote_checked": false
          },
          "also_in": [],
