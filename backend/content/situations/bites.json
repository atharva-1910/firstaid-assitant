        },
        {
          "id": "bite_dog_s3",
          "order": 3,
          "text": {
            "en": "If it is bleeding, press on it with a clean cloth.",
            "hi": "अगर खून बह रहा है, तो साफ़ कपड़े से उस पर दबाव डालें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 323,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_dog_s4",
