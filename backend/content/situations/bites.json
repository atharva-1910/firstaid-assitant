          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_snake_s2",
          "verified": false
        },
        {
          "id": "bite_snake_s2",
          "order": 2,
          "text": {
            "en": "Move away from the snake. Do not try to catch or kill it.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 340,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_snake_s3",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "bite_snake_s3",
          "order": 3,
          "text": {
            "en": "Keep the person calm and as still as possible.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 340,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_snake_s4",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "bite_snake_s4",
          "order": 4,
          "text": {
            "en": "Keep the bitten arm or leg still, as you would a broken limb.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 340,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_snake_s5",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "bite_snake_s5",
          "order": 5,
          "text": {
            "en": "Remove rings, bangles, watches and tight clothing near the bite before swelling starts.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 340,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_snake_s6",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "bite_snake_s6",
          "order": 6,
          "text": {
            "en": "Note the time of the bite.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
