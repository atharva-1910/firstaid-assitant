    "snake": {
      "urgency_rules": [
        {
          "if": {},
          "urgency": "emergency"
        }
      ],
      "steps": [
        {
          "id": "bite_snake_s1",
          "order": 1,
          "text": {
            "en": "Call 112 or get them to the nearest hospital immediately.",
            "hi": "112 पर कॉल करें या उन्हें तुरंत सबसे पास के अस्पताल ले जाएँ।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G2",
            "page": null,
            "quote_checked": true
          },
          "also_in": [
            {
              "doc": "G1",
              "page": 340
            }
          ],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_snake_s2",
          "verified": false
        },
        {
          "id": "bite_snake_s2",
          "order": 2,
          "text": {
            "en": "Move away from the snake. Do not try to catch or kill it.",
            "hi": "साँप से दूर हट जाएँ। उसे पकड़ने या मारने की कोशिश न करें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 340,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_snake_s3",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "bite_snake_s3",
          "order": 3,
          "text": {
            "en": "Keep the person calm and as still as possible.",
            "hi": "व्यक्ति को शांत रखें और जितना हो सके, हिलने न दें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 340,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_snake_s4",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "bite_snake_s4",
          "order": 4,
          "text": {
            "en": "Keep the bitten arm or leg still, as you would a broken limb.",
            "hi": "काटे गए हाथ या पैर को स्थिर रखें, जैसे टूटी हड्डी वाले अंग को रखते हैं।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 340,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_snake_s5",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "bite_snake_s5",
          "order": 5,
          "text": {
            "en": "Remove rings, bangles, watches and tight clothing near the bite before swelling starts.",
            "hi": "सूजन आने से पहले, काटे गए स्थान के पास से अँगूठी, चूड़ियाँ, घड़ी और तंग कपड़े उतार दें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 340,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_snake_s6",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "bite_snake_s6",
          "order": 6,
          "text": {
            "en": "Note the time of the bite.",
            "hi": "काटने का समय याद रखें या लिख लें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 340,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": null,
          "verified": false,
          "verify_note": "VERIFY"
        }
      ],
      "do_not": [
        {
          "text": {
            "en": "Do not tie a tourniquet.",
            "hi": "कसकर पट्टी या रस्सी (टूर्निकेट) न बाँधें।",
            "hinglish": "",
            "mr": ""
