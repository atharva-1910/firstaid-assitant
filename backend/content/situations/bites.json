          "reason": {
            "en": "Named as a harmful practice by the Health Ministry (G5).",
            "hi": "स्वास्थ्य मंत्रालय ने इसे हानिकारक तरीका बताया है (G5)।",
            "hinglish": "",
            "mr": ""
          },
          "step": "bite_snake_s4"
        },
        {
          "text": {
            "en": "Do not cut or suck the wound.",
            "hi": "घाव को न काटें और न ही चूसें।",
            "hinglish": "",
            "mr": ""
          },
          "reason": {
            "en": "Named as a harmful practice by the Health Ministry (G5).",
            "hi": "स्वास्थ्य मंत्रालय ने इसे हानिकारक तरीका बताया है (G5)।",
            "hinglish": "",
            "mr": ""
          },
          "step": "bite_snake_s3"
        },
        {
          "text": {
            "en": "Do not use herbal remedies.",
            "hi": "जड़ी-बूटी वाले घरेलू उपाय न करें।",
            "hinglish": "",
            "mr": ""
          },
          "reason": {
            "en": "Delays the anti-venom treatment that saves lives (G5).",
            "hi": "इससे जान बचाने वाले एंटी-वेनम इलाज में देरी होती है (G5)।",
            "hinglish": "",
            "mr": ""
          },
          "step": "bite_snake_s1"
        },
        {
          "text": {
            "en": "Do not apply ice.",
            "hi": "बर्फ़ न लगाएँ।",
            "hinglish": "",
            "mr": ""
          },
          "reason": {
            "en": "",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "step": "bite_snake_s5"
        },
        {
          "text": {
            "en": "Do not wait for symptoms before going to hospital.",
            "hi": "अस्पताल जाने से पहले लक्षणों का इंतज़ार न करें।",
            "hinglish": "",
            "mr": ""
          },
          "reason": {
            "en": "",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "step": "bite_snake_s6"
        }
      ]
    },
    "insect_sting": {
      "urgency_rules": [
        {
          "if": {
            "allergy_signs": "yes"
          },
          "urgency": "emergency"
        },
        {
          "if": {
            "flag": "many_stings"
          },
          "urgency": "emergency"
        },
        {
          "if": {},
          "urgency": "home"
        }
      ],
      "steps": [
        {
          "id": "bite_insect_s1",
          "order": 1,
          "text": {
            "en": "Watch for a severe allergic reaction: trouble breathing, swelling of the face, lips or throat, a spreading rash, or feeling faint. If any appear, call 112.",
            "hi": "गंभीर एलर्जी के लक्षणों पर नज़र रखें: साँस लेने में तकलीफ़, चेहरे, होंठों या गले में सूजन, फैलते हुए चकत्ते, या बेहोशी जैसा लगना। इनमें से कुछ भी दिखे, तो 112 पर कॉल करें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G2",
            "page": null,
            "quote_checked": true
          },
          "also_in": [
            {
              "doc": "G1",
              "page": 326
            }
          ],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_insect_s2",
          "verified": false
        },
        {
          "id": "bite_insect_s2",
          "order": 2,
          "text": {
            "en": "If a sting is left in the skin, remove it quickly.",
            "hi": "अगर डंक त्वचा में रह गया है, तो उसे जल्दी निकाल दें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 326,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_insect_s3",
          "verified": false,
          "verify_note": "VERIFY method"
        },
        {
          "id": "bite_insect_s3",
          "order": 3,
          "text": {
            "en": "Wash the area with soap and water.",
            "hi": "उस जगह को साबुन और पानी से धोएँ।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 326,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_insect_s4",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "bite_insect_s4",
          "order": 4,
          "text": {
            "en": "Apply a cold pack wrapped in cloth to ease pain and swelling.",
            "hi": "दर्द और सूजन कम करने के लिए कपड़े में लपेटा ठंडा पैक लगाएँ।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 326,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "bite_insect_s5",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "bite_insect_s5",
          "order": 5,
          "text": {
            "en": "For a scorpion sting, take them to a clinic or hospital.",
            "hi": "बिच्छू के डंक पर उन्हें क्लिनिक या अस्पताल ले जाएँ।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G2",
            "page": null,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": null,
          "verified": false,
          "verify_note": "VERIFY"
        }
      ],
      "do_not": [
        {
          "text": {
            "en": "Do not squeeze or scratch the area.",
            "hi": "उस जगह को न दबाएँ और न खुजलाएँ।",
            "hinglish": "",
            "mr": ""
          },
          "reason": {
            "en": "",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "step": "bite_insect_s2"
        },
        {
          "text": {
            "en": "Do not apply mud, lime or other home remedies.",
            "hi": "मिट्टी, चूना या दूसरे घरेलू उपाय न लगाएँ।",
