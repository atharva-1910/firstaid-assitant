        }
      ],
      "steps": [
        {
          "id": "bite_snake_s1",
          "order": 1,
          "text": {
            "en": "Call 112 or get them to the nearest hospital immediately.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
