      "steps": [
        {
          "id": "burns_elec_s1",
          "order": 1,
          "text": {
            "en": "Do not touch the person until the power is switched off at the main switch or plug, or they are clear of the source.",
            "hi": "जब तक मेन स्विच या प्लग से बिजली बंद न हो जाए, या व्यक्ति बिजली के स्रोत से दूर न हो जाए, तब तक उन्हें न छुएँ।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": null,
