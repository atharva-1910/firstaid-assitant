          "urgency": "emergency"
        },
        {
          "if": {
            "flag": "distress"
          },
          "urgency": "emergency"
        },
        {
          "if": {},
          "urgency": "clinic"
        }
      ],
      "steps": [
        {
          "id": "burns_chem_s1",
          "order": 1,
          "text": {
            "en": "Protect yourself: avoid touching the chemical; use gloves or a plastic bag if you can.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 288,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_chem_s2",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "burns_chem_s2",
          "order": 2,
          "text": {
            "en": "Call 112.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 288,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_chem_s3",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "burns_chem_s3",
          "order": 3,
          "text": {
            "en": "Brush off any dry powder, then remove clothing and jewellery that the chemical touched.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G2",
            "page": null,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_chem_s4",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "burns_chem_s4",
          "order": 4,
          "text": {
            "en": "Rinse the skin with large amounts of running water for at least 20 minutes.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G2",
            "page": null,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_chem_s5",
          "verified": false,
          "verify_note": "VERIFY duration"
        },
        {
          "id": "burns_chem_s5",
          "order": 5,
          "text": {
            "en": "If it is in the eye, rinse the eye with running water, holding the eyelids open, and keep rinsing until help arrives.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G2",
            "page": null,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_chem_s6",
          "verified": false,
          "verify_note": "VERIFY duration"
        },
        {
          "id": "burns_chem_s6",
          "order": 6,
          "text": {
            "en": "Cover the area loosely with a clean cloth.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 288,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": null,
          "verified": false,
          "verify_note": "VERIFY"
        }
      ],
      "do_not": [
        {
          "text": {
            "en": "Do not try to neutralise the chemical with anything else (such as baking soda, vinegar or milk).",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "reason": {
            "en": "It can cause more damage; rinse with water instead.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "step": "burns_chem_s4"
        },
        {
          "text": {
            "en": "Do not rub the area or the eye.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "reason": {
            "en": "",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "step": "burns_chem_s5"
        }
      ]
    },
    "electrical": {
      "urgency_rules": [
        {
          "if": {},
          "urgency": "emergency"
        }
      ],
      "steps": [
        {
          "id": "burns_elec_s1",
          "order": 1,
          "text": {
            "en": "Do not touch the person until the power is switched off at the main switch or plug, or they are clear of the source.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": null,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_elec_s2",
          "verified": false,
          "verify_note": "VERIFY (G1 scene safety)"
        },
        {
          "id": "burns_elec_s2",
          "order": 2,
          "text": {
            "en": "Stay well away from high-voltage lines; wait for the power company or emergency services.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "UNSOURCED",
            "page": null,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_elec_s3",
          "verified": false,
          "verify_note": "VERIFY: source needed"
        },
        {
          "id": "burns_elec_s3",
          "order": 3,
          "text": {
            "en": "Call 112.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "UNSOURCED",
            "page": null,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_elec_s4",
          "verified": false,
          "verify_note": "VERIFY: source needed"
        },
        {
          "id": "burns_elec_s4",
          "order": 4,
          "text": {
            "en": "If they are unresponsive and not breathing normally, start CPR (Situation 9.1, Path A).",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G3",
            "page": null,
            "quote_checked": true
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_elec_s5",
          "verified": false,
          "link": {
            "situation": "unresponsive",
            "branch": "path_a"
          }
        },
        {
          "id": "burns_elec_s5",
          "order": 5,
          "text": {
            "en": "Once it is safe, cool any visible burns under running water and cover them loosely.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 288,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": null,
          "verified": false,
          "verify_note": "VERIFY"
        }
      ],
      "do_not": [
