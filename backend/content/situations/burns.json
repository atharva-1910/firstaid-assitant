        }
      ],
      "steps": [
        {
          "id": "burns_fire_s1",
          "order": 1,
          "text": {
            "en": "Stop the burning: move away from the heat; if clothes are on fire, stop, drop and roll.",
            "hi": "जलना रोकें: गर्मी से दूर हटें; अगर कपड़ों में आग लगी है, तो रुकें, ज़मीन पर लेटें और लुढ़कें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 288,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_fire_s2",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "burns_fire_s2",
          "order": 2,
          "text": {
            "en": "Cool the burn under clean, cool running water as soon as possible, for at least 20 minutes.",
            "hi": "जले हुए हिस्से को जितनी जल्दी हो सके, साफ़ और ठंडे बहते पानी में कम से कम 20 मिनट तक ठंडा करें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 288,
            "quote_checked": false
          },
          "also_in": [
            {
              "doc": "G2",
              "page": null
            },
            {
              "doc": "G4",
              "page": null
            }
          ],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_fire_s3",
          "verified": false,
          "verify_note": "VERIFY duration in each source"
        },
        {
          "id": "burns_fire_s3",
          "order": 3,
          "text": {
            "en": "Remove jewellery, belts and other tight items from the burned area.",
            "hi": "जले हुए हिस्से से गहने, बेल्ट और दूसरी तंग चीज़ें उतार दें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G2",
            "page": null,
            "quote_checked": true
          },
          "also_in": [
            {
              "doc": "G1",
              "page": 288
            }
          ],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_fire_s4",
          "verified": false
        },
        {
          "id": "burns_fire_s4",
          "order": 4,
          "text": {
            "en": "Do not remove clothing that is stuck to the burn.",
            "hi": "जले हुए हिस्से से चिपके कपड़े न उतारें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 288,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_fire_s5",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "burns_fire_s5",
          "order": 5,
          "text": {
            "en": "Cover the burn loosely with cling film or a clean cloth that does not leave fibres.",
            "hi": "जले हुए हिस्से को क्लिंग फ़िल्म या ऐसे साफ़ कपड़े से ढीला ढकें जिसके रेशे न छूटें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 288,
            "quote_checked": false
          },
          "also_in": [
            {
              "doc": "G2",
              "page": null
            }
          ],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_fire_s6",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "burns_fire_s6",
          "order": 6,
          "text": {
            "en": "Keep the person warm: cool the burn, not the whole person.",
            "hi": "व्यक्ति को गर्म रखें: केवल जले हुए हिस्से को ठंडा करें, पूरे शरीर को नहीं।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 288,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": "burns_fire_s7",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "burns_fire_s7",
          "order": 7,
          "text": {
            "en": "Call 112 or go to a clinic based on the urgency shown on screen.",
            "hi": "स्क्रीन पर दिखाई गई गंभीरता के अनुसार 112 पर कॉल करें या क्लिनिक जाएँ।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 288,
            "quote_checked": false
          },
          "also_in": [],
          "agreement": "unchecked",
          "evidence": "unchecked",
          "next": null,
          "verified": false,
          "verify_note": "VERIFY"
        }
      ],
      "do_not": [
        {
          "text": {
            "en": "Do not use ice or ice water.",
            "hi": "बर्फ़ या बर्फ़ वाला पानी इस्तेमाल न करें।",
            "hinglish": "",
            "mr": ""
          },
          "reason": {
            "en": "It can damage the skin further.",
            "hi": "इससे त्वचा को और नुकसान हो सकता है।",
            "hinglish": "",
            "mr": ""
          },
          "step": "burns_fire_s2"
        },
        {
          "text": {
            "en": "Do not apply butter, oil, ghee, toothpaste or other home remedies.",
            "hi": "मक्खन, तेल, घी, टूथपेस्ट या दूसरे घरेलू उपाय न लगाएँ।",
            "hinglish": "",
            "mr": ""
          },
          "reason": {
            "en": "It traps heat and raises the risk of infection.",
            "hi": "इससे गर्मी अंदर रुक जाती है और संक्रमण का ख़तरा बढ़ता है।",
            "hinglish": "",
            "mr": ""
          },
          "step": "burns_fire_s5"
        },
        {
          "text": {
            "en": "Do not burst blisters.",
            "hi": "फफोले न फोड़ें।",
            "hinglish": "",
            "mr": ""
