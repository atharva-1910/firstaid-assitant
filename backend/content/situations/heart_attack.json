        },
        {
          "id": "ha_s5",
          "order": 5,
          "text": {
            "en": "If they have their own prescribed medicine for chest pain, help them take it.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 358,
