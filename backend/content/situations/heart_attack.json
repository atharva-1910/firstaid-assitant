          "evidence": "unchecked",
          "next": "ha_s3",
          "verified": false,
          "verify_note": "VERIFY"
        },
        {
          "id": "ha_s3",
          "order": 3,
          "text": {
            "en": "Loosen tight clothing.",
            "hi": "तंग कपड़े ढीले कर दें।",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 358,
