  "recognition": [
    {
      "en": "Pain, pressure, squeezing or tightness in the chest, which may spread to the arm, jaw, neck or back; may come with breathlessness, sweating, nausea or feeling faint. Symptoms can be mild.",
      "hi": "",
      "hinglish": "",
      "mr": ""
    }
  ],
