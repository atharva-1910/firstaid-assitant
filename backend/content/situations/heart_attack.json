        },
        {
          "id": "ha_s6",
          "order": 6,
          "text": {
            "en": "Ask someone to find an AED if one is nearby.",
            "hi": "",
            "hinglish": "",
            "mr": ""
          },
          "source": {
            "doc": "G1",
            "page": 358,
